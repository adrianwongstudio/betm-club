---
layout: layout.njk
title: The Burnaby Entrepreneurs Gala
description: Our annual celebration of the year's speeches, awards, and members.
permalink: /gala/
---

{% set ph = gala.page_hero %}
{% include "sections/page-hero.njk" %}

{% if gala.recap and gala.recap.rows.length %}
<section class="section section--white">
  <div class="wrap">
    {% if gala.recap.heading %}
      <div class="section-head" style="margin-bottom: 56px;">
        <div>
          <div class="eyebrow">Recap</div>
          <h2 class="section-h2">{{ gala.recap.heading }}</h2>
        </div>
      </div>
    {% endif %}
    <div class="feature-rows">
      {% for row in gala.recap.rows %}
        <article class="feature-row {{ 'feature-row--image-right' if loop.index0 % 2 == 1 }}">
          <div class="feature-row__media {{ 'feature-row__media--pair' if row.images.length > 1 }}">
            {% for img in row.images %}
              <img src="{{ img.src }}" alt="{{ img.alt or row.heading }}" loading="lazy">
            {% endfor %}
          </div>
          <div class="feature-row__body">
            {% if row.eyebrow %}<span class="feature-row__eyebrow">{{ row.eyebrow }}</span>{% endif %}
            <h3 class="feature-row__heading">{{ row.heading }}</h3>
            {% if row.text %}<p class="feature-row__text">{{ row.text }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if gala.video and gala.video.url %}
<section class="section section--alt">
  <div class="wrap">
    <div class="video-row">
      <div class="video-row__body">
        {% if gala.video.eyebrow %}<span class="video-row__eyebrow">{{ gala.video.eyebrow }}</span>{% endif %}
        <h2 class="video-row__heading">{{ gala.video.heading }}</h2>
        {% if gala.video.text %}<p class="video-row__text">{{ gala.video.text }}</p>{% endif %}
      </div>
      <div class="video-row__frame">
        {% if gala.video.url | isVideoFile %}
          <video controls playsinline preload="metadata"
            {% if gala.video.poster %}poster="{{ gala.video.poster }}"{% endif %}>
            <source src="{{ gala.video.url }}">
          </video>
        {% else %}
          <iframe
            src="{{ gala.video.url | videoEmbedUrl }}"
            title="{{ gala.video.heading }}"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if gala.extras and gala.extras.length %}
<section class="section section--alt">
  <div class="wrap page-body">
    {% for block in gala.extras %}
      <div class="page-body__block">
        <h2 class="section-h2" style="font-size: 28px;">{{ block.heading }}</h2>
        <p>{{ block.body }}</p>
      </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if gala.supporters and ((gala.supporters.sponsors.items | length) or (gala.supporters.auction.items | length)) %}
<section class="section section--alt">
  <div class="wrap">
    {% if gala.supporters.heading %}
      <div class="section-head" style="margin-bottom: 40px;">
        <div>
          <div class="eyebrow">Thanks</div>
          <h2 class="section-h2">{{ gala.supporters.heading }}</h2>
          {% if gala.supporters.intro %}
            <p style="max-width: 44em; margin: 16px 0 0; font-size: 17px; color: var(--secondary-ink);">{{ gala.supporters.intro }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="logo-groups">
      {% if gala.supporters.sponsors.items and gala.supporters.sponsors.items.length %}
        <div class="logo-group">
          <div class="logo-group__head">
            <div>
              <div class="logo-group__eyebrow">{{ gala.supporters.sponsors.eyebrow or 'Sponsors' }}</div>
              {% if gala.supporters.sponsors.title %}
                <h3 class="logo-group__title" style="margin-top: 8px;">{{ gala.supporters.sponsors.title }}</h3>
              {% endif %}
            </div>
          </div>
          <div class="logo-grid logo-grid--lg">
            {% for item in gala.supporters.sponsors.items %}
              {% if item.url %}
                <a class="logo-tile" href="{{ item.url }}" target="_blank" rel="noopener" title="{{ item.name }}">
                  {% if item.image %}<img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy">
                  {% else %}<span class="logo-tile__name">{{ item.name }}</span>{% endif %}
                </a>
              {% else %}
                <div class="logo-tile" title="{{ item.name }}">
                  {% if item.image %}<img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy">
                  {% else %}<span class="logo-tile__name">{{ item.name }}</span>{% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if gala.supporters.auction.items and gala.supporters.auction.items.length %}
        <div class="logo-group">
          <div class="logo-group__head">
            <div>
              <div class="logo-group__eyebrow">{{ gala.supporters.auction.eyebrow or 'Auction contributors' }}</div>
              {% if gala.supporters.auction.title %}
                <h3 class="logo-group__title" style="margin-top: 8px;">{{ gala.supporters.auction.title }}</h3>
              {% endif %}
            </div>
          </div>
          <div class="logo-grid">
            {% for item in gala.supporters.auction.items %}
              {% if item.url %}
                <a class="logo-tile" href="{{ item.url }}" target="_blank" rel="noopener" title="{{ item.name }}">
                  {% if item.image %}<img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy">
                  {% else %}<span class="logo-tile__name">{{ item.name }}</span>{% endif %}
                </a>
              {% else %}
                <div class="logo-tile" title="{{ item.name }}">
                  {% if item.image %}<img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy">
                  {% else %}<span class="logo-tile__name">{{ item.name }}</span>{% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
