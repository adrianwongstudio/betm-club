---
layout: layout.njk
title: Members
description: Three ways members grow every week — prepared speeches, table topics, and meeting roles.
permalink: /members/
---

{% set ph = members.page_hero %}
{% include "sections/page-hero.njk" %}
{% include "sections/members.njk" %}

{% if members.roles %}
<section class="section section--white">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">Roles</div>
        <h2 class="section-h2">{{ members.roles.heading }}</h2>
      </div>
    </div>
    <p style="max-width: 60ch; margin: 0 0 40px; font-size: 17px; color: var(--secondary-ink);">{{ members.roles.body }}</p>
    <ul class="roles-list">
      {% for role in members.roles.items %}
        <li class="roles-list__item">
          <h3 class="roles-list__name">{{ role.name }}</h3>
          <p class="roles-list__body">{{ role.body }}</p>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
