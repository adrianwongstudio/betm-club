---
layout: layout.njk
title: Communication — Members
description: How members build communication skills at Burnaby Entrepreneurs Toastmasters — Competent Communicator and Pathways.
permalink: /members/communication/
---

{% import "macros/icons.njk" as icons %}
{% set ph = communication.page_hero %}
{% include "sections/page-hero.njk" %}

{# ───────── Unique-approach callout ───────── #}
{% if communication.unique_approach and communication.unique_approach.body %}
<section class="section--yellow" style="padding: 32px 32px;">
  <div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; justify-content: space-between;">
    <p style="margin: 0; font-family: var(--sans); font-weight: 600; font-size: 19px; line-height: 1.5; color: var(--loyal-blue); max-width: 44em;">{{ communication.unique_approach.body }}</p>
    {% if communication.unique_approach.cta %}
      <a href="{{ communication.unique_approach.cta.href }}" class="btn btn--maroon">{{ communication.unique_approach.cta.label }}</a>
    {% endif %}
  </div>
</section>
{% endif %}

{# ───────── Competent Communicator (first) ───────── #}
{% set cc = communication.competent_communicator %}
<section class="section section--white">
  <div class="wrap">
    <div class="section-head" style="margin-bottom: 32px;">
      <div>
        <div class="eyebrow">{{ cc.eyebrow }}</div>
        <h2 class="section-h2">{{ cc.heading }}</h2>
      </div>
    </div>
    <p style="max-width: 60ch; margin: 0 0 40px; font-size: 17px; line-height: 1.7; color: var(--secondary-ink);">{{ cc.intro }}</p>
    <ol class="cc-projects">
      {% for p in cc.projects %}
        <li class="cc-project">
          <div class="cc-project__num">{{ p.num }}</div>
          <div class="cc-project__body">
            <div class="cc-project__head">
              <h3 class="cc-project__name">{{ p.name }}</h3>
              <span class="cc-project__time">{{ p.time }}</span>
            </div>
            <p class="cc-project__objective">{{ p.objective }}</p>
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ───────── Pathways ───────── #}
{% set pw = communication.pathways %}
<section class="section section--alt">
  <div class="wrap">
    <div class="section-head" style="margin-bottom: 32px;">
      <div>
        <div class="eyebrow">{{ pw.eyebrow }}</div>
        <h2 class="section-h2">{{ pw.heading }}</h2>
      </div>
    </div>
    <p style="max-width: 60ch; margin: 0 0 40px; font-size: 17px; line-height: 1.7; color: var(--secondary-ink);">{{ pw.intro }}</p>

    <div class="{% if pw.paths and pw.paths.length %}two-col{% endif %}" style="margin-bottom: 48px;">
      <div>
        <h3 style="font-family: var(--sans); font-size: 20px; font-weight: 700; color: var(--loyal-blue); margin: 0 0 16px;">How it works</h3>
        <ul class="checked-list">
          {% for it in pw.features %}<li>{{ icons.icon("check", "checked-list__icon") }}<span>{{ it }}</span></li>{% endfor %}
        </ul>
      </div>
      {% if pw.paths and pw.paths.length %}
      <div>
        {% if pw.paths_heading %}<h3 style="font-family: var(--sans); font-size: 20px; font-weight: 700; color: var(--loyal-blue); margin: 0 0 16px;">{{ pw.paths_heading }}</h3>{% endif %}
        <div class="competencies">
          {% for p in pw.paths %}<span class="competencies__pill">{{ p }}</span>{% endfor %}
        </div>
      </div>
      {% endif %}
    </div>

    {% if pw.more_link and pw.more_link.href %}
      <p><a class="text-link" href="{{ pw.more_link.href }}" target="_blank" rel="noopener">{{ pw.more_link.label }}</a></p>
    {% endif %}
  </div>
</section>
