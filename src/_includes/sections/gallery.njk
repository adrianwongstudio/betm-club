{% set gl = gallery %}
{% set cells = gl_cells or gl.preview_cells %}
<section id="gallery" class="section section--sm section--white">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">{{ gl.eyebrow }}</div>
        <h2 class="section-h2">{{ gl.headline }}</h2>
      </div>
      {% if gl.link %}<a href="{{ gl.link.href | url }}" class="text-link">{{ gl.link.label }}</a>{% endif %}
    </div>
    <div class="mosaic">
      {% for cell in cells %}
        <div class="mosaic__cell mosaic__cell--{{ cell.span }} ph">
          {% if cell.image %}
            <img src="{{ cell.image }}" alt="{{ cell.caption }}">
          {% else %}
            <span class="ph__chip">{{ cell.caption }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
