{% set m = members %}
<section id="members" class="section section--alt">
  <div class="wrap">
    <div class="section-head section-head--large">
      <div>
        <div class="eyebrow">{{ m.eyebrow }}</div>
        <h2 class="section-h2" style="max-width: 24em;">{{ m.headline }}</h2>
      </div>
      {% if m.link %}<a href="{{ m.link.href | url }}" class="text-link">{{ m.link.label }}</a>{% endif %}
    </div>
    <div class="cards">
      {% for card in m.cards %}
        <article class="card {{ 'card--noimg' if not card.image and not card.placeholder }}">
          {% if card.image or card.placeholder %}
          <div class="card__media ph ph--card">
            {% if card.image %}
              <img src="{{ card.image }}" alt="{{ card.title }}">
            {% else %}
              <span class="ph__chip">{{ card.placeholder }}</span>
            {% endif %}
          </div>
          {% endif %}
          <div class="card__body">
            <span class="card__eyebrow">{{ card.eyebrow }}</span>
            <h3 class="card__title">{{ card.title }}</h3>
            <p class="card__excerpt">{{ card.body }}</p>
            {% if card.cta %}<a href="{{ card.cta.href | url }}" class="card__link text-link text-link--sm">{{ card.cta.label }}</a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
